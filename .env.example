# Copy to .env.local and fill in the real values. Never put real keys in this file (it is committed).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...     # from the backend developer
CLERK_SECRET_KEY=sk_test_...                       # for proxy.ts only, never reaches the browser
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_SITE_URL=http://localhost:3000             # public website origin, used for canonical and hreflang links
